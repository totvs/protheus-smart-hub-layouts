{
	"table": {
		"name": "MIH",
		"alias": "MIH"
	},
	"view_deleted": false,
	"filters": {
		"column": "MIH.MIH_TIPCAD",
		"operator": "EQUALS",
		"compare_value": "PERFIL DE OPERADOR  "
	},
	"fields": [
		{
			"description": "nome",
			"alias": "nome",
			"column_name": "MIH.MIH_DESC",
			"is_physical": true,
			"transformations": [
				{
					"function": "TRIM"
				}
			]
		},
		{
			"description": "situacao",
			"alias": "situacao",
			"is_physical": false,
			"logic_operation": {
				"type": "CASE",
				"cases": [
					{
						"when": {
							"logic_group": "OR",
							"conditions": [
								{
									"column": "MIH.MIH_ATIVO",
									"operator": "EQUALS",
									"compare_value": "2"
								},
								{
									"column": "MIH.D_E_L_E_T_",
									"operator": "EQUALS",
									"compare_value": "*"
								}
							]
						},
						"then": {
							"value": 0,
							"value_type": "STATIC"
						}
					}
				],
				"else": {
					"value": 1,
					"value_type": "STATIC"
				}
			}
		},
		{
			"description": "tipoPerfil",
			"alias": "tipoPerfil",
			"is_json_extract": true,
			"json_extract_config": {
				"source_column": "MIH.MIH_CONFIG",
				"root_path": "$.Components",
				"fields": [
					{
						"alias": "campo",
						"json_path": "$.IdComponent",
						"type": "VARCHAR(20)"
					},
					{
						"alias": "conteudo",
						"json_path": "$.ComponentContent",
						"type": "NVARCHAR(1)",
						"extract_field": true,
						"transformations": [
							{
								"function": "COALESCE",
								"params": {
									"fallback_value": 0
								}
							}
						]
					}
				],
				"filters": {
					"column": "campo",
					"operator": "EQUALS",
					"compare_value": "tipoPerfil"
				}
			}
		},
		{
			"description": "idInquilino",
			"alias": "idInquilino",
			"is_json_extract": true,
			"json_extract_config": {
				"is_source_posicione": true,
				"posicione_config": {
					"target_table": "MHO",
					"target_alias": "MHO",
					"target_column": "MHO.MHO_CONFIG",
					"match_filter": {
						"column": "MHO.MHO_COD",
						"operator": "EQUALS",
						"value_type": "STATIC",
						"compare_value": "PDVSYNC"
					}
				},
				"root_path": "$",
				"fields": [
					{
						"alias": "inquilino",
						"json_path": "$.inquilino",
						"type": "VARCHAR(30)",
						"extract_field": true
					}
				]
			}
		},
		{
			"description": "idRetaguarda",
			"alias": "idRetaguarda",
			"column_name": "MIH.MIH_ID",
			"is_physical": true,
			"transformations": [
				{
					"function": "TRIM"
				}
			]
		},
		{
			"description": "descontoMaximoItem",
			"alias": "descontoMaximoItem",
			"is_json_extract": true,
			"json_extract_config": {
				"source_column": "MIH.MIH_CONFIG",
				"root_path": "$.Components",
				"fields": [
					{
						"alias": "campo",
						"json_path": "$.IdComponent",
						"type": "VARCHAR(20)"
					},
					{
						"alias": "conteudo",
						"json_path": "$.ComponentContent",
						"type": "NVARCHAR(5)",
						"extract_field": true,
						"cast_to": "INT"
					}
				],
				"filters": {
					"column": "campo",
					"operator": "EQUALS",
					"compare_value": "descontoMaximoItem"
				}
			}
		},
		{
			"description": "descontoMaximoTotal",
			"alias": "descontoMaximoTotal",
			"is_json_extract": true,
			"json_extract_config": {
				"source_column": "MIH.MIH_CONFIG",
				"root_path": "$.Components",
				"fields": [
					{
						"alias": "campo",
						"json_path": "$.IdComponent",
						"type": "VARCHAR(20)"
					},
					{
						"alias": "conteudo",
						"json_path": "$.ComponentContent",
						"type": "NVARCHAR(5)",
						"extract_field": true,
						"cast_to": "INT"
					}
				],
				"filters": {
					"column": "campo",
					"operator": "EQUALS",
					"compare_value": "descontoMaximoTotal"
				}
			}
		},
		{
			"description": "idProprietario",
			"alias": "idProprietario",
			"is_physical": false,
			"is_proprietary": true,
