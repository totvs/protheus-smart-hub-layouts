	"idRetaguardaCliente": "&IIF( Len( self:oPublica['MEI'] ) > 0, self:oPublica['MEI'][1]['MEI_CODCLI'] + self:oPublica['MEI'][1]['MEI_LOJA'], ' ' )", 
	"idRetaguardaProduto": "&self:oPublica['MB8_CODPRO']",
