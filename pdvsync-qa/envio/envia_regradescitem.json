	"valor": "&IIF( self:oPublica['MB8_DESCPR'] > 0, self:oPublica['MB8_DESCPR'], self:oPublica['MB8_DESCVL'] )",
	"idRetaguardaGrupoCliente": "&IIF( Len( self:oPublica['MEI'] ) > 0, self:oPublica['MEI'][1]['MEI_GRPVEN'], ' ' )",
